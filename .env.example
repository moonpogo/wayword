# Wayword local/server environment example
# Copy to a local untracked .env and fill with real values outside git.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_RLS_VERIFIED=false

# Server-only secrets. Do not expose these to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
WAYWORD_ALPHA_PULSE_TOKEN=your-internal-alpha-pulse-token

# Optional local test helpers
SUPABASE_TEST_USER_A_EMAIL=writer-a@example.com
SUPABASE_TEST_USER_A_PASSWORD=replace-me
SUPABASE_TEST_USER_B_EMAIL=writer-b@example.com
SUPABASE_TEST_USER_B_PASSWORD=replace-me
